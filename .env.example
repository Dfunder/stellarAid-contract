# ==============================================================================
# StellarAid Contract & Worker Environment Configuration
# ==============================================================================
# Copy this file to .env and customize the values for your local setup:
#   cp .env.example .env
#
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Stellar & Soroban RPC Network Settings
# ------------------------------------------------------------------------------

# Soroban RPC Endpoint URL
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Horizon Endpoint URL
HORIZON_URL=https://horizon-testnet.stellar.org

# Network Passphrase for Stellar Testnet
# For Testnet: "Test SDF Network ; September 2015"
# For Futurenet: "Test SDF Future Network ; October 2022"
# For Public Mainnet: "Public Global Stellar Network ; July 2015"
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Stellar Network Identifier (e.g., testnet, futurenet, standalone, mainnet)
STELLAR_NETWORK=testnet

# ------------------------------------------------------------------------------
# Smart Contract Configuration
# ------------------------------------------------------------------------------

# Deployed StellarAid Donation Contract ID (C... strkey format)
DONATION_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Platform signing secret key for authorized operations (S... secret key format)
STELLAR_PLATFORM_SECRET=SD00000000000000000000000000000000000000000000000000000000

# ------------------------------------------------------------------------------
# Worker Server Configuration
# ------------------------------------------------------------------------------

# HTTP Server Bind Address and Port for the Worker service
BIND_ADDRESS=0.0.0.0:3000

# Logging Level (trace, debug, info, warn, error)
LOG_LEVEL=info
