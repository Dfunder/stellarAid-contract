# Copy to `.env` and source it from a secret manager or local shell.
# Never commit `.env` or a real secret. See docs/ENV_REFERENCE.md.

# Signing source: prefer the identity name; the secret is injected at runtime.
STELLAR_DEPLOYER_IDENTITY=deployer
STELLAR_DEPLOYER_SECRET=

# Mainnet-only gates. Leave unset for testnet.
STELLAR_ALLOW_MAINNET=
STELLAR_MAINNET_CONFIRM=

# Optional tooling overrides.
SOROBAN_CONFIG=./.soroban/config.toml
WASM_DIR=./target/wasm32-unknown-unknown/release
DEPLOYMENT_MANIFEST=./scripts/deploy/contracts.toml
NETWORK=testnet
NO_COLOR=
