# StellarAid worker configuration. Copy to .env and adjust:  cp .env.example .env
# All values below are read in worker/src/main.rs; the defaults shown are used
# when a variable is unset (DONATION_CONTRACT_ID has no usable default).

# Soroban RPC endpoint used to simulate and submit contract invocations.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Horizon API endpoint used for account and transaction lookups.
HORIZON_URL=https://horizon-testnet.stellar.org

# Network passphrase; must match the network the RPC/Horizon URLs point to.
# Mainnet: "Public Global Stellar Network ; September 2015"
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract ID (C...) of the deployed donation contract. Required for donations.
DONATION_CONTRACT_ID=

# Address and port the worker HTTP server binds to.
BIND_ADDRESS=0.0.0.0:3000
